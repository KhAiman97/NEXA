# Supabase project settings > API  (use a NEW, dedicated project for this app)
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public URL of the deployed app (HTTPS is required for installing the PWA on a phone)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: never add the service-role key here. The app does not use it; RLS enforces access.
